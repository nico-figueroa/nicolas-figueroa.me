---
import navigation from "../content/navigation.json";
import site from "../content/site.json";
---

<header class="border-b border-[var(--line)]">
  <div class="mx-auto flex max-w-[96rem] flex-wrap items-center justify-between gap-4 px-4 py-5 sm:px-6">
    <a class="font-semibold tracking-tight text-[var(--text)]" href="/" aria-label={`${site.name} home`}>
      {site.name}
    </a>
    <nav aria-label="Main navigation">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-[var(--muted)]">
        {navigation.map((item) => (
          <li><a class="nav-link" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to light theme">
      Light theme
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-theme-toggle]");

  toggle?.addEventListener("click", () => {
    const root = document.documentElement;
    const isDark = root.dataset.theme !== "light";
    root.dataset.theme = isDark ? "light" : "dark";
    toggle.setAttribute("aria-label", `Switch to ${isDark ? "dark" : "light"} theme`);
    toggle.textContent = `${isDark ? "Dark" : "Light"} theme`;
  });
</script>
