---
interface Props {
  question: string;
}

const { question } = Astro.props;
---

<a
  class="fixed bottom-4 right-4 z-20 max-w-[calc(100vw-2rem)] rounded-full border border-[var(--accent)] bg-[var(--accent)] px-5 py-3 text-center text-sm font-semibold text-[var(--on-accent)] shadow-xl transition-colors hover:brightness-110 sm:bottom-6 sm:right-6 sm:max-w-sm"
  href={`/the-guide/?question=${encodeURIComponent(question)}`}
>
  Not finding what you're looking for? Ask the Guide!
</a>
