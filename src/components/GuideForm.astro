<form class="mt-10 max-w-3xl space-y-4" data-guide-form>
  <div>
    <label class="font-medium" for="guide-question">What would you like to know?</label>
    <textarea
      class="mt-2 min-h-32 w-full rounded-xl border border-[var(--line)] bg-[var(--surface)] p-4 text-[var(--text)]"
      id="guide-question"
      name="question"
      maxlength="1200"
      required
      aria-describedby="guide-help"
    ></textarea>
    <p class="mt-2 text-sm text-[var(--muted)]" id="guide-help">
      Answers are limited to cited portfolio sources. Do not include private or sensitive information.
    </p>
  </div>
  <button class="button button-primary" type="submit">Ask The Guide</button>
  <p class="text-sm text-[var(--muted)]" aria-live="polite" data-guide-status></p>
</form>

<section class="mt-10 max-w-3xl space-y-8" data-guide-results hidden aria-live="polite">
  <div>
    <h2 class="text-xl font-semibold">Answer</h2>
    <div class="mt-3 space-y-4 leading-7 text-[var(--muted)]" data-guide-answer></div>
    <p class="mt-3 rounded-lg border border-[var(--line)] px-4 py-3 text-sm text-[var(--muted)]" role="note" data-guide-disclaimer></p>
    <p class="mt-3 text-sm text-[var(--muted)]" data-guide-notice></p>
  </div>
  <div>
    <h2 class="text-xl font-semibold">Supporting Evidence</h2>
    <ul class="mt-3 space-y-4" data-guide-evidence></ul>
  </div>
  <div>
    <h2 class="text-xl font-semibold">References</h2>
    <ul class="mt-3 list-inside list-disc space-y-2" data-guide-sources></ul>
  </div>
  <div>
    <h2 class="text-xl font-semibold">Suggested Questions</h2>
    <ul class="mt-3 flex flex-wrap gap-3" data-guide-suggestions></ul>
  </div>
</section>

<script>
  import { readApiResponse } from "../scripts/api-response.mjs";

  const form = document.querySelector("[data-guide-form]");
  const questionField = document.querySelector("#guide-question");
  const status = document.querySelector("[data-guide-status]");
  const results = document.querySelector("[data-guide-results]");
  const answer = document.querySelector("[data-guide-answer]");
  const disclaimer = document.querySelector("[data-guide-disclaimer]");
  const notice = document.querySelector("[data-guide-notice]");

  function appendListItem(list, text, className = "") {
    const item = document.createElement("li");
    if (className) item.className = className;
    item.textContent = text;
    list.append(item);
    return item;
  }

  function appendFormattedText(element, text) {
    for (const part of text.split(/(\*\*[^*]+\*\*)/g)) {
      if (part.startsWith("**") && part.endsWith("**")) {
        const strong = document.createElement("strong");
        strong.className = "font-semibold text-[var(--text)]";
        strong.textContent = part.slice(2, -2);
        element.append(strong);
      } else {
        element.append(document.createTextNode(part));
      }
    }
  }

  function renderAnswer(text) {
    answer.replaceChildren();
    const lines = text
      .replace(/\s+(?=(?:[-*]\s+|\d+[.)]\s+))/g, "\n")
      .split(/\r?\n/);
    let paragraph = [];
    let list;
    const flushParagraph = () => {
      if (!paragraph.length) return;
      const element = document.createElement("p");
      appendFormattedText(element, paragraph.join(" "));
      answer.append(element);
      paragraph = [];
    };
    const flushList = () => {
      list = null;
    };

    for (const rawLine of lines) {
      const line = rawLine.trim();
      if (!line) {
        flushParagraph();
        flushList();
        continue;
      }
      const heading = line.match(/^(#{1,3})\s+(.+)$/);
      if (heading) {
        flushParagraph();
        flushList();
        const element = document.createElement(heading[1].length === 1 ? "h3" : "h4");
        element.className = "font-semibold text-[var(--text)]";
        appendFormattedText(element, heading[2]);
        answer.append(element);
        continue;
      }
      const item = line.match(/^(?:[-*]\s+|\d+[.)]\s+)(.+)$/);
      if (item) {
        flushParagraph();
        if (!list) {
          list = document.createElement("ul");
          list.className = "list-inside list-disc space-y-2";
          answer.append(list);
        }
        const element = document.createElement("li");
        appendFormattedText(element, item[1]);
        list.append(element);
        continue;
      }
      flushList();
      paragraph.push(line);
    }
    flushParagraph();
  }

  const initialQuestion = new URLSearchParams(window.location.search).get("question");
  if (questionField instanceof HTMLTextAreaElement && initialQuestion) {
    questionField.value = initialQuestion.slice(0, 1200);
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (
      !(form instanceof HTMLFormElement)
      || !(questionField instanceof HTMLTextAreaElement)
      || !(status instanceof HTMLElement)
      || !(results instanceof HTMLElement)
      || !(answer instanceof HTMLElement)
      || !(disclaimer instanceof HTMLElement)
      || !(notice instanceof HTMLElement)
    ) return;
    status.textContent = "Searching verified portfolio sources…";
    results.hidden = true;

    try {
      const response = await fetch("/.netlify/functions/ai-guide", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ question: questionField.value }),
      });
      const payload = await readApiResponse(response);

      renderAnswer(payload.answer);
      disclaimer.textContent = payload.aiStatus === "generated"
        ? "AI-generated response: details may be inaccurate or incomplete. Confirm important claims with the cited source links."
        : "Evidence-only response: use the cited source links to confirm details and review their full context.";
      notice.textContent = payload.notice || "";
      const evidenceList = results.querySelector("[data-guide-evidence]");
      const sourceList = results.querySelector("[data-guide-sources]");
      const suggestionList = results.querySelector("[data-guide-suggestions]");
      if (!(evidenceList instanceof HTMLUListElement)
        || !(sourceList instanceof HTMLUListElement)
        || !(suggestionList instanceof HTMLUListElement)) {
        throw new Error("The Guide response area is unavailable.");
      }
      evidenceList?.replaceChildren();
      sourceList?.replaceChildren();
      suggestionList?.replaceChildren();

      for (const item of payload.supportingEvidence || []) {
        const entry = appendListItem(evidenceList, "");
        const title = document.createElement("strong");
        title.textContent = `${item.title}: `;
        const excerpt = document.createElement("span");
        excerpt.textContent = item.excerpt;
        const source = document.createElement("a");
        source.href = item.source;
        source.textContent = ` Source: ${item.title}`;
        source.rel = "noreferrer";
        source.className = "text-[var(--accent)] underline";
        entry.replaceChildren(title, excerpt, source);
      }
      for (const source of payload.citations || payload.sources || []) {
        const entry = appendListItem(sourceList, "");
        const link = document.createElement("a");
        link.href = source.url;
        link.textContent = source.title;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.className = "text-[var(--accent)] underline";
        entry.append(link);
      }
      for (const suggestion of payload.suggestedQuestions || []) {
        const entry = appendListItem(suggestionList, "");
        const button = document.createElement("button");
        button.type = "button";
        button.className = "button button-secondary";
        button.textContent = suggestion;
        button.addEventListener("click", () => {
          questionField.value = suggestion;
          form.requestSubmit();
        });
        entry.append(button);
      }

      results.hidden = false;
      status.textContent = payload.aiStatus === "generated"
        ? "Answer generated from cited evidence."
        : "Showing evidence-only fallback.";
    } catch (error) {
      status.textContent = error instanceof Error
        ? error.message
        : "The Guide is temporarily unavailable.";
    }
  });
</script>
