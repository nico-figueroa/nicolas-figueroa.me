---
interface Props {
  name: string;
  description: string;
  technologies: string[];
  source: string;
  productionLinks?: { label: string; url: string }[];
}

const { name, description, technologies, source, productionLinks = [] } = Astro.props;
---

<article class="flex h-full min-w-0 flex-col rounded-xl border border-[var(--line)] bg-[var(--surface)] p-5 sm:p-6">
  <h2 class="text-xl font-semibold">{name}</h2>
  <p class="mt-3 flex-1 break-words leading-7 text-[var(--muted)]">{description}</p>
  <ul class="mt-4 flex flex-wrap gap-2" aria-label={`${name} technologies`}>
    {technologies.map((technology) => (
      <li class="max-w-full break-words rounded-full border border-[var(--line)] px-3 py-1 text-xs text-[var(--muted)]">{technology}</li>
    ))}
  </ul>
  <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-sm">
    <a class="break-words text-[var(--accent)] underline" href={source}>Source repository</a>
    {productionLinks.map((link) => (
      <a class="break-words text-[var(--accent)] underline" href={link.url}>{link.label}</a>
    ))}
  </div>
</article>
