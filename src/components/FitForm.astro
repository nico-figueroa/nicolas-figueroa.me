---
// FitForm.astro - Displays a form for checking Nico's fit for a job description.
import ResponsiveCard from "./ResponsiveCard.astro";
---

<form class="mt-10 w-full min-w-0 space-y-4" data-fit-form>
  <div class="space-y-4">
    <div>
      <label class="font-medium" for="fit-input-mode">Job description input</label>
      <select
        class="mt-2 w-full rounded-xl border border-[var(--line)] bg-[var(--surface)] p-3 text-[var(--text)]"
        id="fit-input-mode"
        aria-describedby="fit-help"
      >
        <option value="text">Paste text or JSON</option>
        <option value="url">Public HTTPS URL</option>
        <option value="file">Upload a file</option>
      </select>
    </div>
    <div data-fit-text-group>
      <label class="font-medium" for="job-description">Job description</label>
      <textarea
        class="mt-2 min-h-48 w-full rounded-xl border border-[var(--line)] bg-[var(--surface)] p-4 text-[var(--text)]"
        id="job-description"
        name="jobDescription"
        maxlength="12000"
      ></textarea>
    </div>
    <div data-fit-url-group hidden>
      <label class="font-medium" for="job-description-url">Job description URL</label>
      <input
        class="mt-2 w-full rounded-xl border border-[var(--line)] bg-[var(--surface)] p-3 text-[var(--text)]"
        id="job-description-url"
        type="url"
        inputmode="url"
        autocomplete="url"
        placeholder="https://example.com/careers/role"
      />
      <p class="mt-2 text-sm text-[var(--muted)]">
        Public HTTPS pages only. Private destinations, redirects, and non-HTML files are blocked.
      </p>
    </div>
    <div data-fit-file-group hidden>
      <label class="font-medium" for="job-description-file">Job description file</label>
      <input
        class="mt-2 block w-full rounded-xl border border-[var(--line)] bg-[var(--surface)] p-3 text-[var(--text)]"
        id="job-description-file"
        type="file"
        accept=".pdf,.doc,.docx,.txt,.md,.csv,.tsv,.json,.html,.htm,.rtf"
      />
      <p class="mt-2 text-sm text-[var(--muted)]">
        PDF, Word (DOC/DOCX), TXT, Markdown, CSV/TSV, JSON, HTML, and RTF; maximum 2 MB. Scanned PDFs may not contain extractable text.
      </p>
    </div>
    <p class="text-sm text-[var(--muted)]" id="fit-help">
      OpenAI receives the extracted job-description text and public portfolio evidence to classify requirements and assess fit. Code validates evidence references and calculates the score.
      AI assessments can be wrong; this is an evidence-coverage estimate, not a hiring decision. Analysis may take up to a minute and requires the AI service to be available.
      Do not submit confidential or sensitive information.
      See the <a class="text-[var(--accent)] underline" href="/privacy-policy/">Privacy Policy</a> for processing and retention details.
    </p>
  </div>
  <button class="button button-primary" type="submit" data-fit-submit>Check Nico's Fit</button>
  <div class="flex items-start gap-2 text-sm text-[var(--muted)]">
    <span class="fit-spinner" data-fit-spinner hidden aria-hidden="true"></span>
    <p aria-live="polite" data-fit-status></p>
  </div>
</form>

<section class="report-grid mt-10 w-full min-w-0 break-words scroll-mt-6" data-fit-results hidden aria-live="polite">
  <div class="report-span rounded-xl border border-[var(--line)] bg-[var(--surface)] p-5" data-fit-summary>
    <h2 class="text-xl font-semibold">Results summary</h2>
    <dl class="mt-4 grid gap-5 sm:grid-cols-2">
      <div>
        <dt class="text-sm text-[var(--muted)]">Fit (evidence coverage)</dt>
        <dd class="mt-1 text-3xl font-semibold" data-fit-score></dd>
      </div>
      <div>
        <dt class="text-sm text-[var(--muted)]">Number of gaps</dt>
        <dd class="mt-1 text-3xl font-semibold" data-fit-gap-count></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-sm text-[var(--muted)]">Estimated learning time for skill gaps</dt>
        <dd class="mt-1 text-sm leading-6" data-fit-summary-time></dd>
      </div>
    </dl>
    <p class="mt-4 leading-7 text-[var(--muted)]" data-fit-summary-paragraph></p>
  </div>
  <ResponsiveCard title="Score methodology and source" heading="h2" alwaysCollapsible>
    <p class="mt-2 leading-7 text-[var(--muted)]" data-fit-explanation></p>
    <p class="mt-2"><a class="text-sm text-[var(--accent)] underline" data-fit-source></a></p>
  </ResponsiveCard>
  <ResponsiveCard title="Requirement-by-requirement Assessment" heading="h2" alwaysCollapsible class="report-span">
    <p class="mt-2 leading-7 text-[var(--muted)]">
      Each requirement is normalized and checked for consistent evidence before scoring.
      Confidence describes the strength of the documented assessment, not a hiring probability.
      Direct, equivalent, and exceeding evidence receive the same full credit.
    </p>
    <p class="mt-2 text-sm text-[var(--muted)]" data-fit-validation></p>
    <div class="report-subcards mt-4" data-fit-requirements></div>
  </ResponsiveCard>
  <ResponsiveCard title="Relevant Skills" heading="h2" alwaysCollapsible>
    <ul class="mt-3 flex flex-wrap gap-2" data-fit-skills></ul>
  </ResponsiveCard>
  <ResponsiveCard title="Interpersonal and Transferable Capabilities" heading="h2" alwaysCollapsible>
    <p class="mt-2 leading-7 text-[var(--muted)]">
      Soft skills are evaluated separately from technical skills using documented responsibilities and outcomes.
    </p>
    <ul class="mt-3 list-inside list-disc space-y-2" data-fit-transferable></ul>
  </ResponsiveCard>
  <ResponsiveCard title="Supported Qualifications" heading="h2" alwaysCollapsible>
    <p class="mt-2 leading-7 text-[var(--muted)]">
      Direct, equivalent, and exceeding qualifications receive full credit when supported by the documented evidence.
    </p>
    <ul class="mt-3 list-inside list-disc space-y-2" data-fit-supported></ul>
  </ResponsiveCard>
  <ResponsiveCard title="Partially Supported Requirements" heading="h2" alwaysCollapsible>
    <p class="mt-2 leading-7 text-[var(--muted)]">
      Related evidence is available, but it does not establish the exact role requirement.
    </p>
    <ul class="mt-3 list-inside list-disc space-y-2" data-fit-partial></ul>
  </ResponsiveCard>
  <ResponsiveCard title="Relevant Experience" heading="h2" alwaysCollapsible>
    <ul class="mt-3 flex flex-wrap gap-2" data-fit-experience></ul>
  </ResponsiveCard>
  <ResponsiveCard title="Relevant Projects" heading="h2" alwaysCollapsible>
    <ul class="report-subcards mt-3" data-fit-projects></ul>
  </ResponsiveCard>
  <ResponsiveCard title="Potential Gaps" heading="h2" alwaysCollapsible>
    <p class="mt-2 leading-7 text-[var(--muted)]">
      Requirements not established by the available profile or candidate-confirmed evidence. Only technical-skill and engineering-capability gaps receive illustrative study estimates; credentials, tenure, human capabilities and domain experience do not.
    </p>
    <ul class="mt-3 list-inside list-disc space-y-2" data-fit-gaps></ul>
  </ResponsiveCard>
  <ResponsiveCard title="Industry-domain Gaps" heading="h2" alwaysCollapsible>
    <p class="mt-2 leading-7 text-[var(--muted)]">
      Domain experience is evaluated independently. A missing industry background does not negate demonstrated engineering capabilities.
    </p>
    <ul class="mt-3 list-inside list-disc space-y-2" data-fit-domain-gaps></ul>
  </ResponsiveCard>
  <ResponsiveCard title="Growth Projection" heading="h2" alwaysCollapsible class="report-span">
    <p class="mt-2 font-semibold text-[var(--accent)]" data-fit-growth-label></p>
    <p class="mt-2 leading-7 text-[var(--muted)]" data-fit-growth-basis></p>
    <div class="report-subcards mt-4" data-fit-growth-levels></div>
  </ResponsiveCard>
  <ResponsiveCard title="Recommended Content" heading="h2" alwaysCollapsible>
    <ul class="mt-3 list-inside list-disc space-y-2" data-fit-recommendations></ul>
  </ResponsiveCard>
  <ResponsiveCard title="Excluded Job-description Content" heading="h2" alwaysCollapsible>
    <p class="mt-2 leading-7 text-[var(--muted)]">Benefits, employer commentary and application information are classified separately and never scored.</p>
    <ul class="mt-3 list-inside list-disc space-y-2" data-fit-excluded></ul>
  </ResponsiveCard>
</section>

<script>
  import { readApiResponse } from "../scripts/api-response.mjs";
  import { summarizeFit } from "../scripts/fit-summary.mjs";
  import { startFitProgress } from "../scripts/fit-progress.mjs";

  const form = document.querySelector("[data-fit-form]");
  const mode = document.querySelector("#fit-input-mode");
  const field = document.querySelector("#job-description");
  const urlField = document.querySelector("#job-description-url");
  const fileField = document.querySelector("#job-description-file");
  const status = document.querySelector("[data-fit-status]");
  const spinner = document.querySelector("[data-fit-spinner]");
  const results = document.querySelector("[data-fit-results]");
  const submitButton = form?.querySelector("[data-fit-submit]");

  function updateInputMode() {
    if (!(mode instanceof HTMLSelectElement)
      || !(field instanceof HTMLTextAreaElement)
      || !(urlField instanceof HTMLInputElement)
      || !(fileField instanceof HTMLInputElement)) return;
    const textGroup = form?.querySelector("[data-fit-text-group]");
    const urlGroup = form?.querySelector("[data-fit-url-group]");
    const fileGroup = form?.querySelector("[data-fit-file-group]");
    if (!(textGroup instanceof HTMLElement)
      || !(urlGroup instanceof HTMLElement)
      || !(fileGroup instanceof HTMLElement)) return;
    textGroup.hidden = mode.value !== "text";
    urlGroup.hidden = mode.value !== "url";
    fileGroup.hidden = mode.value !== "file";
    field.disabled = mode.value !== "text";
    urlField.disabled = mode.value !== "url";
    fileField.disabled = mode.value !== "file";
    field.required = mode.value === "text";
    urlField.required = mode.value === "url";
    fileField.required = mode.value === "file";
  }

  mode?.addEventListener("change", updateInputMode);
  updateInputMode();

  function fillList(selector, values, formatValue = (value) => value) {
    const list = results?.querySelector(selector);
    if (!list) return;
    list.replaceChildren();
    for (const value of values) {
      const item = document.createElement("li");
      item.textContent = formatValue(value);
      list.append(item);
    }
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (
      !(form instanceof HTMLFormElement)
      || !(mode instanceof HTMLSelectElement)
      || !(field instanceof HTMLTextAreaElement)
      || !(urlField instanceof HTMLInputElement)
      || !(fileField instanceof HTMLInputElement)
      || !(status instanceof HTMLElement)
      || !(results instanceof HTMLElement)
    ) return;
    if (submitButton instanceof HTMLButtonElement && submitButton.disabled) return;
    if (spinner instanceof HTMLElement) spinner.hidden = false;
    const stopProgress = startFitProgress((message) => { status.textContent = message; }, mode.value === "url"
      ? "Retrieving the public job-description page…"
      : mode.value === "file"
        ? "Reading the job-description file…"
        : "Comparing the job description with documented portfolio evidence…");
    results.hidden = true;
    if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;

    try {
      let request;
      if (mode.value === "file") {
        const file = fileField.files?.[0];
        if (!file) throw new Error("Choose a job-description file to upload.");
        const body = new FormData();
        body.append("file", file);
        request = { method: "POST", body };
      } else {
        request = {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(mode.value === "url"
            ? { jobDescriptionUrl: urlField.value }
            : { jobDescription: field.value }),
        };
      }
      const response = await fetch("/.netlify/functions/check-nicos-fit", {
        ...request,
      });
      const payload = await readApiResponse(response);

      const gapCount = results.querySelector("[data-fit-gap-count]");
      const summaryTime = results.querySelector("[data-fit-summary-time]");
      const summaryParagraph = results.querySelector("[data-fit-summary-paragraph]");
      if (!gapCount || !summaryTime || !summaryParagraph) {
        throw new Error("The Fit summary area is unavailable.");
      }
      const reportSummary = summarizeFit(payload);
      gapCount.textContent = String(reportSummary.gapCount);
      summaryTime.textContent = reportSummary.learningTime;
      summaryParagraph.textContent = reportSummary.paragraph;
      results.querySelectorAll("details[data-report-section]").forEach((section) => {
        if (section instanceof HTMLDetailsElement) section.open = false;
      });
      const score = results.querySelector("[data-fit-score]");
      const explanation = results.querySelector("[data-fit-explanation]");
      const source = results.querySelector("[data-fit-source]");
      const growthLabel = results.querySelector("[data-fit-growth-label]");
      const growthBasis = results.querySelector("[data-fit-growth-basis]");
      const growthLevels = results.querySelector("[data-fit-growth-levels]");
      if (!score || !explanation || !source || !(growthLabel instanceof HTMLElement)
        || !(growthBasis instanceof HTMLElement)
        || !(growthLevels instanceof HTMLElement)) {
        throw new Error("The Fit results area is unavailable.");
      }
      growthLabel.textContent = payload.growthProjection.label;
      score.textContent = `${payload.matchScore}%`;
      explanation.textContent = payload.scoreExplanation;
      const assessment = results.querySelector("[data-fit-requirements]");
      const validation = results.querySelector("[data-fit-validation]");
      if (!(assessment instanceof HTMLElement) || !(validation instanceof HTMLElement)
        || !payload.validation?.passed || !Array.isArray(payload.requirements)) {
        throw new Error("The assessment did not pass its consistency checks.");
      }
      validation.textContent = `Validation checks passed: ${payload.validation.checks.join("; ")}. Semantic judgments are AI-generated, not independently guaranteed.`;
      assessment.replaceChildren();
      for (const requirement of payload.requirements) {
        const card = document.createElement("details");
        card.className = "responsive-card report-section rounded-xl border border-[var(--line)] bg-[var(--surface)] p-5";
        card.dataset.reportSection = "";
        const summary = document.createElement("summary");
        const heading = document.createElement("h3");
        heading.className = "font-semibold";
        heading.textContent = requirement.label;
        const chevron = document.createElement("span");
        chevron.className = "card-chevron";
        chevron.setAttribute("aria-hidden", "true");
        summary.append(heading, chevron);
        const body = document.createElement("div");
        body.className = "card-content";
        const fields = document.createElement("dl");
        fields.className = "space-y-3 text-sm leading-6";
        for (const [label, value] of [
          ["Requirement", requirement.label],
          ["Original wording", requirement.sourceText],
          ["Category", requirement.category],
          ["Importance", requirement.importance || "Role criterion"],
          ["Evidence Found", requirement.evidence],
          ["Evidence Type", requirement.evidenceType],
          ["Confidence", `${Math.round(requirement.confidence * 100)}%`],
          ["Result", requirement.result],
        ]) {
          const term = document.createElement("dt");
          term.className = "font-semibold";
          term.textContent = label;
          const definition = document.createElement("dd");
          definition.textContent = value;
          fields.append(term, definition);
        }
        body.append(fields);
        const citations = document.createElement("ul");
        citations.className = "mt-3 space-y-2";
        for (const record of requirement.sources) {
          const item = document.createElement("li");
          const link = document.createElement("a");
          link.href = record.url;
          link.textContent = `${record.kind}: ${record.title}`;
          link.className = "text-sm text-[var(--accent)] underline";
          item.append(link);
          if (record.quote) {
            const quote = document.createElement("blockquote");
            quote.className = "mt-1 text-sm text-[var(--muted)]";
            quote.textContent = record.quote;
            item.append(quote);
          }
          citations.append(item);
        }
        body.append(citations);
        card.append(summary, body);
        assessment.append(card);
      }
      source.href = payload.source;
      source.textContent = "Source profile";
      fillList("[data-fit-skills]", payload.relevantSkills);
      fillList("[data-fit-excluded]", payload.excludedContent || [],
        (item) => `${item.category}: ${item.sourceText} — ${item.reason}`);
      fillList(
        "[data-fit-transferable]",
        payload.transferableCapabilities,
        (item) => `${item.label} — ${item.result}: ${item.evidence}`,
      );
      fillList(
        "[data-fit-supported]",
        payload.supportedRequirements,
        (item) => `${item.label} — ${item.matchType}: ${item.evidence}`,
      );
      fillList(
        "[data-fit-partial]",
        payload.partiallySupportedRequirements || [],
        (item) => `${item.label} — ${item.evidence}`,
      );
      fillList("[data-fit-experience]", payload.relevantExperience);
      fillList("[data-fit-gaps]", payload.potentialGaps);
      fillList("[data-fit-domain-gaps]", payload.domainGaps, (item) => `${item.label} — ${item.evidence}`);
      const projects = results.querySelector("[data-fit-projects]");
      if (!(projects instanceof HTMLUListElement)) {
        throw new Error("The Fit projects area is unavailable.");
      }
      projects.replaceChildren();
      for (const project of payload.relevantProjects || []) {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = project.source;
        link.textContent = `${project.name} — ${project.reason}`;
        link.className = "text-[var(--accent)] underline";
        item.append(link);
        projects.append(item);
      }
      const recommendations = results.querySelector("[data-fit-recommendations]");
      if (!(recommendations instanceof HTMLUListElement)) {
        throw new Error("The Fit recommendations area is unavailable.");
      }
      recommendations.replaceChildren();
      for (const recommendation of payload.recommendedContent || []) {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = recommendation.url;
        link.textContent = recommendation.title;
        link.className = "text-[var(--accent)] underline";
        item.append(link);
        recommendations.append(item);
      }
      growthBasis.textContent = payload.growthProjection.basis;
      growthLevels.replaceChildren();
      for (const level of payload.growthProjection.levels || []) {
        const card = document.createElement("details");
        card.className = "responsive-card report-section rounded-xl border border-[var(--line)] bg-[var(--surface)] p-5";
        card.dataset.reportSection = "";
        const summary = document.createElement("summary");
        const heading = document.createElement("h3");
        heading.className = "text-lg font-semibold";
        heading.textContent = level.label;
        const chevron = document.createElement("span");
        chevron.className = "card-chevron";
        chevron.setAttribute("aria-hidden", "true");
        summary.append(heading, chevron);
        const content = document.createElement("div");
        content.className = "card-content";
        const target = document.createElement("p");
        target.className = "mt-1 text-sm text-[var(--muted)]";
        target.textContent = level.target;
        const overall = document.createElement("p");
        overall.className = "mt-3 font-medium text-[var(--accent)]";
        overall.textContent = `All identified skills: ${level.overall.time}`;
        const skills = document.createElement("ul");
        skills.className = "mt-3 space-y-2 text-sm text-[var(--muted)]";
        for (const item of level.skills) {
          const entry = document.createElement("li");
          const name = document.createElement("strong");
          name.className = "text-[var(--text)]";
          name.textContent = `${item.skill}: `;
          entry.append(name, document.createTextNode(item.time));
          skills.append(entry);
        }
        content.append(target, overall, skills);
        card.append(summary, content);
        growthLevels.append(card);
      }
      results.hidden = false;
      status.textContent = "AI assessment complete. Evidence references were validated and the score was calculated from the assessed requirements.";
      results.scrollIntoView({
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",
        block: "start",
      });
    } catch (error) {
      status.textContent = error instanceof Error
        ? error.message
        : "Fit analysis is temporarily unavailable.";
    } finally {
      stopProgress();
      if (spinner instanceof HTMLElement) spinner.hidden = true;
      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
    }
  });
</script>
