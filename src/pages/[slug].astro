---
import pages from "../content/pages.json";
import projects from "../content/projects.json";
import profile from "../content/profile.json";
import resume from "../content/resume.json";
import site from "../content/site.json";
import SiteLayout from "../layouts/SiteLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import contact from "../content/contact.json";
import GuideForm from "../components/GuideForm.astro";
import FitForm from "../components/FitForm.astro";
import media from "../content/media.json";
import ContactForm from "../components/ContactForm.astro";
import GuidePrompt from "../components/GuidePrompt.astro";

export function getStaticPaths() {
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const widePages = new Set(["experience", "journey", "media", "projects", "resume"]);
const { page } = Astro.props;
---

<SiteLayout title={page.title} description={page.description} wide={widePages.has(page.slug)}>
  <article class:list={widePages.has(page.slug) ? "w-full" : "max-w-3xl"}>
    <p class="mb-4 text-sm font-medium uppercase tracking-[0.18em] text-[var(--accent)]">
      {page.title} · {site.sectionEyebrow}
    </p>
    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">{page.title}</h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-[var(--muted)]">{page.description}</p>
    {page.slug === "projects" ? (
      <div class="mt-10 grid items-stretch gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
        {projects.map((project) => <ProjectCard {...project} />)}
      </div>
    ) : page.slug === "resume" ? (
      <div class="mt-10 grid items-stretch gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
        {resume.views.map((view) => (
          <a class="h-full min-w-0 rounded-xl border border-[var(--line)] bg-[var(--surface)] p-6 transition-colors hover:border-[var(--accent)]" href={`/resume/${view.slug}/`}>
            <h2 class="text-xl font-semibold">{view.label}</h2>
            <p class="mt-3 leading-7 text-[var(--muted)]">{view.focus}</p>
          </a>
        ))}
      </div>
      <GuidePrompt question="What additional information should I explore in these resume views?" />
    ) : page.slug === "experience" ? (
      <div class="mt-10 space-y-8">
        <p class="leading-7 text-[var(--muted)]">{profile.experience.focus}</p>
        <section>
          <h2 class="text-xl font-semibold">Career history</h2>
          <div class="mt-4 grid items-stretch gap-4 sm:grid-cols-2 2xl:grid-cols-4">
            {profile.experience.positions.map((position) => (
              <article class="h-full min-w-0 rounded-xl border border-[var(--line)] bg-[var(--surface)] p-5">
                <h3 class="font-semibold">{position.title}</h3>
                <p class="mt-1 text-[var(--accent)]">{position.organization} · {position.period}</p>
                {position.location && <p class="mt-1 text-sm text-[var(--muted)]">{position.location}</p>}
                <ul class="mt-3 list-inside list-disc space-y-2 leading-7 text-[var(--muted)]">
                  {position.highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </section>
        <section>
          <h2 class="text-xl font-semibold">Industries</h2>
          <ul class="mt-4 flex flex-wrap gap-3">
            {profile.experience.industries.map((industry) => (
              <li class="rounded-full border border-[var(--line)] px-4 py-2">{industry}</li>
            ))}
          </ul>
        </section>
        <a class="text-[var(--accent)] underline" href={profile.source}>Source: LinkedIn profile</a>
      </div>
    ) : page.slug === "journey" ? (
      <div class="mt-10 space-y-8">
        <section>
          <h2 class="text-xl font-semibold">Education</h2>
          <ul class="mt-4 grid items-stretch gap-4 sm:grid-cols-2 2xl:grid-cols-4">
            {profile.education.map((item) => (
              <li class="h-full min-w-0 rounded-xl border border-[var(--line)] bg-[var(--surface)] p-5">
                <h3 class="font-semibold">{item.name}</h3>
                {item.institution && <p class="mt-1 text-[var(--muted)]">{item.institution}</p>}
                {item.period && <p class="mt-1 text-sm text-[var(--accent)]">{item.period}</p>}
                {item.detail && <p class="mt-1 text-[var(--muted)]">{item.detail}</p>}
              </li>
            ))}
          </ul>
        </section>
        <section>
          <h2 class="text-xl font-semibold">Certifications and ongoing learning</h2>
          <ul class="mt-4 space-y-3">
            {profile.certifications.map((certification) => (
              <li>
                <a class="text-[var(--accent)] underline" href={certification.credentialUrl || certification.source}>
                  {certification.name}
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-5 leading-7 text-[var(--muted)]">{profile.learning}</p>
        </section>
        <section>
          <h2 class="text-xl font-semibold">Languages</h2>
          <ul class="mt-4 flex flex-wrap gap-3">
            {profile.spokenLanguages.map((language) => (
              <li class="rounded-full border border-[var(--line)] px-4 py-2">{language}</li>
            ))}
          </ul>
        </section>
        <a class="text-[var(--accent)] underline" href={profile.source}>Source: LinkedIn profile</a>
      </div>
    ) : page.slug === "contact" ? (
      <div class="mt-10 space-y-8">
        <ContactForm />
        <ul class="flex flex-wrap gap-4">
          {contact.map((item) => (
            <li><a class="button button-secondary" href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>
    ) : page.slug === "media" ? (
      <ul class="mt-10 grid items-stretch gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
        {media.map((item) => (
          <li class="flex h-full min-w-0 flex-col rounded-xl border border-[var(--line)] bg-[var(--surface)] p-6">
            <h2 class="text-xl font-semibold">{item.title}</h2>
            <p class="mt-2 flex-1 leading-7 text-[var(--muted)]">{item.description}</p>
            <a class="mt-4 inline-flex break-words text-[var(--accent)] underline" href={item.url} target="_blank" rel="noreferrer">{item.label}</a>
          </li>
        ))}
      </ul>
    ) : page.slug === "the-guide" ? (
      <GuideForm />
    ) : page.slug === "check-fit" ? (
      <FitForm />
    ) : (
      <p class="mt-10 border-l-2 border-[var(--accent)] pl-5 text-[var(--muted)]">{page.placeholder}</p>
    )}
  </article>
</SiteLayout>
