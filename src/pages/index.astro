---
import SiteLayout from "../layouts/SiteLayout.astro";
import site from "../content/site.json";
import NetworkMap from "../components/NetworkMap.astro";
---

<SiteLayout title="Home" description={site.brandStatement} wide>
  <section class="home-hero grid gap-10 lg:items-center">
    <div class="min-w-0">
      <p class="mb-5 text-sm font-medium uppercase tracking-[0.18em] text-[var(--accent)]">
        {site.focusAreas.join(" · ")}
      </p>
      <h1 class="max-w-3xl text-4xl font-semibold leading-tight tracking-tight md:text-6xl">
        Nicolas Figueroa: Exploring how complex systems learn, adapt, and evolve.
      </h1>
      <p class="mt-6 max-w-2xl text-xl leading-8 text-[var(--text)]">
        Through engineering, software, artificial intelligence, and the study of complex systems.
      </p>
      <p class="mt-4 max-w-2xl text-base leading-7 text-[var(--muted)]">{site.introduction}</p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a class="button button-primary" href={site.primaryAction.href}>{site.primaryAction.label}</a>
        <a class="button button-secondary" href={site.secondaryAction.href}>{site.secondaryAction.label}</a>
      </div>
    </div>
    <NetworkMap />
  </section>
</SiteLayout>
