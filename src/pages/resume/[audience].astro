---
import resume from "../../content/resume.json";
import profile from "../../content/profile.json";
import projects from "../../content/projects.json";
import SiteLayout from "../../layouts/SiteLayout.astro";
import GuidePrompt from "../../components/GuidePrompt.astro";

export function getStaticPaths() {
  const skillGroupLabels = {
    languages: "Programming languages",
    platformsAndFrameworks: "Platforms and frameworks",
    practices: "Practices and domains",
    aiAndMachineLearning: "AI and machine learning",
    spokenLanguages: "Spoken languages",
  };
  return resume.views.map((view) => {
    const skillGroups = view.skillGroups.map((key) => {
      const skills = key === "spokenLanguages"
        ? profile.spokenLanguages
        : profile.skills[key];
      const selectedSkills = view.skillFilters[key]
        ? skills.filter((skill) => view.skillFilters[key].includes(skill))
        : skills;
      return {
        key,
        label: skillGroupLabels[key],
        skills: selectedSkills,
      };
    }).filter((group) => group.skills.length > 0);
    const detailsBySection = {
      experience: profile.experience.positions.filter((position) =>
        view.experienceTitles.includes(position.title),
      ),
      skills: skillGroups,
      projects: view.projectNames
        .map((name) => projects.find((project) => project.name === name))
        .filter(Boolean),
      education: [
      ...profile.education.map((item) => ({
        label: [item.name, item.institution, item.period, item.detail].filter(Boolean).join(" — "),
      })),
      ...profile.certifications.map((item) => ({
        label: item.name,
        url: item.credentialUrl || item.source,
      })),
      ],
    };
    const sections = resume.sections
      .filter((section) => section.audiences.includes(view.slug))
      .map((section) => ({
        ...section,
        title: view.sectionTitles[section.id] || section.title,
        content: view.sectionDescriptions[section.id] || section.content,
        details: detailsBySection[section.id] || [],
      }))
      .sort((left, right) =>
        view.sectionOrder.indexOf(left.id) - view.sectionOrder.indexOf(right.id),
      );

    return {
      params: { audience: view.slug },
      props: { view, sections },
    };
  });
}

const { view, sections } = Astro.props;
---

<SiteLayout title={`${view.label} Resume`} description={view.focus} wide>
  <article class="w-full" data-resume-presentation={view.presentation}>
    <a class="text-sm text-[var(--accent)] underline" href="/resume/">All resume views</a>
    <p class="mb-4 mt-8 text-sm font-medium uppercase tracking-[0.18em] text-[var(--accent)]">
      {view.label} perspective
    </p>
    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">{view.label} Resume</h1>
    <p class="mt-6 text-lg leading-8 text-[var(--muted)]">{view.focus}</p>
    <p class="mt-8 max-w-5xl rounded-xl border border-[var(--line)] bg-[var(--surface)] p-6 leading-7">
      {view.summary}
    </p>
    <div class="mt-8 grid gap-5">
      {sections.map((section) => (
        <section class="min-w-0 rounded-xl border border-[var(--line)] p-5 sm:p-6">
          <h2 class="text-xl font-semibold">{section.title}</h2>
          <p class="mt-3 leading-7 text-[var(--muted)]">{section.content}</p>
          {section.id === "experience" && (
            <div class="mt-4 grid items-stretch gap-4 md:grid-cols-2 2xl:grid-cols-4">
              {section.details.map((position) => (
                <article class="h-full min-w-0 rounded-lg border border-[var(--line)] bg-[var(--surface)] p-4">
                  <h3 class="font-semibold">{position.title}</h3>
                  <p class="mt-1 text-sm text-[var(--accent)]">{position.organization} · {position.period}</p>
                  {position.location && <p class="mt-1 text-sm text-[var(--muted)]">{position.location}</p>}
                  <ul class="mt-3 list-inside list-disc space-y-2 text-sm leading-6 text-[var(--muted)]">
                    {position.highlights.slice(0, view.experienceHighlightLimit).map((highlight) => <li>{highlight}</li>)}
                  </ul>
                </article>
              ))}
            </div>
          )}
          {section.id === "skills" && (
            <div class="mt-4 grid gap-4 md:grid-cols-2 2xl:grid-cols-4">
              {section.details.map((group) => (
                <section class="min-w-0 rounded-lg border border-[var(--line)] bg-[var(--surface)] p-4">
                  <h3 class="font-semibold">{group.label}</h3>
                  <ul class="mt-3 flex flex-wrap gap-2">
                    {group.skills.map((skill) => (
                      <li class="max-w-full break-words rounded-full border border-[var(--line)] px-3 py-1 text-sm text-[var(--muted)]">{skill}</li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          )}
          {section.id === "education" && (
            <ul class="mt-4 grid gap-3 md:grid-cols-2 2xl:grid-cols-4">
              {section.details.map((detail) => (
                <li class="min-w-0 rounded-lg border border-[var(--line)] bg-[var(--surface)] p-4 leading-6">
                  {detail.url
                    ? <a class="text-[var(--accent)] underline" href={detail.url}>{detail.label}</a>
                    : detail.label}
                </li>
              ))}
            </ul>
          )}
          {section.id === "projects" && (
            <>
              <div class="mt-4 grid items-stretch gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
                {section.details.map((project) => (
                  <article class="flex h-full min-w-0 flex-col rounded-lg border border-[var(--line)] bg-[var(--surface)] p-4">
                    <h3 class="font-semibold">{project.name}</h3>
                    <p class="mt-2 flex-1 leading-6 text-sm text-[var(--muted)]">{project.description}</p>
                    <ul class="mt-3 flex flex-wrap gap-2">
                      {project.technologies.map((technology) => (
                        <li class="max-w-full break-words rounded-full border border-[var(--line)] px-2 py-1 text-xs text-[var(--muted)]">{technology}</li>
                      ))}
                    </ul>
                    <a class="mt-4 break-words text-sm text-[var(--accent)] underline" href={project.source}>Project details</a>
                  </article>
                ))}
              </div>
              <a class="mt-5 inline-flex text-[var(--accent)] underline" href="/projects/">Browse all projects</a>
            </>
          )}
        </section>
      ))}
    </div>
    <a class="mt-8 inline-flex text-[var(--accent)] underline" href="/contact/">Contact</a>
  </article>
  <GuidePrompt question={`What additional information is relevant to the ${view.label} perspective?`} />
</SiteLayout>
