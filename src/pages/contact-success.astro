---
// contact-success.astro - Page displayed after a successful contact form submission.
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Message received"
  description="Thank you for reaching out to Nicolas."
>
  <section class="max-w-2xl">
    <h1 class="text-4xl font-semibold tracking-tight">Thanks for reaching out.</h1>
    <p class="mt-6 leading-7 text-[var(--muted)]">
      Your message has been submitted. I'll be in touch as soon as I can.
    </p>
    <a class="mt-6 inline-flex text-[var(--accent)] underline" href="/">Return home</a>
  </section>
</SiteLayout>
